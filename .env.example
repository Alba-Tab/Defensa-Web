DEFENSA_ENTORNO=desarrollo
DEFENSA_MODO=simulado
DEFENSA_DATABASE_URL=sqlite:///./datos/defensa.db
DEFENSA_UMBRAL_EVENTOS=5
DEFENSA_VENTANA_BLOQUEO_SEGUNDOS=60
DEFENSA_DURACION_BLOQUEO_SEGUNDOS=600
DEFENSA_VENTANA_CORRELACION_SEGUNDOS=300
DEFENSA_LISTA_BLANCA=127.0.0.0/8,::1/128,192.168.56.0/24,192.168.56.1/32
DEFENSA_EVE_JSON=/var/log/suricata/eve.json
DEFENSA_FAIL2BAN_BINARIO=/usr/bin/fail2ban-client
DEFENSA_FAIL2BAN_JAIL=defensa-web
DEFENSA_NGINX_SERVICIO=nginx
DEFENSA_FAIL2BAN_SERVICIO=fail2ban
# Dejar la URL vacía para usar la plantilla; al configurarla, Ollama genera los informes.
DEFENSA_OLLAMA_URL=
DEFENSA_OLLAMA_MODELO=llama3.2:1b
DEFENSA_TIMEOUT_IA_SEGUNDOS=20
DEFENSA_JWT_SECRET=
DEFENSA_ADMIN_USUARIO=admin
DEFENSA_ADMIN_PASSWORD=
DEFENSA_MODELO_CLASIFICADOR=servicio/modelos/clasificador.joblib
DEFENSA_UMBRAL_CONFIANZA=0.6
DEFENSA_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
DEFENSA_OPENROUTER_API_KEY=
DEFENSA_OPENROUTER_MODELO=google/gemini-2.5-flash-lite
DEFENSA_OPENROUTER_REFERER=http://localhost:8000
DEFENSA_FCM_CREDENCIALES=secrets/firebase-admin.json
