[Unit]
Description=Plataforma de Defensa Web
After=network-online.target fail2ban.service suricata.service
Wants=network-online.target

[Service]
Type=simple
User=defensa
Group=defensa
WorkingDirectory=/opt/defensa/backend
EnvironmentFile=/etc/defensa/defensa.env
ExecStartPre=/opt/defensa/venv/bin/alembic -c alembic.ini upgrade head
ExecStart=/opt/defensa/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/defensa /var/log/defensa

[Install]
WantedBy=multi-user.target
