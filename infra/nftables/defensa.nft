#!/usr/sbin/nft -f
flush ruleset

table inet defensa {
    chain gestion {
        type filter hook input priority -10; policy accept;
        ct state established,related accept
        iifname "lo" accept
        tcp dport 8000 ip saddr != 192.168.56.0/24 drop
    }

    chain inspeccion {
        type filter hook input priority 0; policy accept;
        tcp dport 80 queue num 0 bypass
    }
}
