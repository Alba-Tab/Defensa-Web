#!/usr/sbin/nft -f
# Reemplaza solo las reglas que pertenecen a la plataforma. Un `flush ruleset`
# global también elimina las cadenas administradas por Docker y Fail2ban.
destroy table inet defensa

table inet defensa {
    chain gestion {
        type filter hook input priority -10; policy accept;
        ct state established,related accept
        iifname "lo" accept
        tcp dport 8000 ip saddr != 192.168.56.0/24 drop
    }

    chain inspeccion_entrada {
        type filter hook input priority 0; policy accept;
        tcp dport 80 queue num 0 bypass
    }

    chain inspeccion_salida {
        type filter hook output priority 0; policy accept;
        tcp sport 80 queue num 0 bypass
    }

    # Modo B: nginx termina TLS y este flujo HTTP de loopback es el que
    # Suricata puede decodificar e inspeccionar antes de Juice Shop.
    chain inspeccion_descifrada {
        type filter hook output priority 0; policy accept;
        oifname "lo" tcp dport 3000 queue num 0 bypass
        oifname "lo" tcp sport 3000 queue num 0 bypass
    }
}
