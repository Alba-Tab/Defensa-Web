drop http any any -> any any (msg:"DEFENSA SQLi de alta confianza"; flow:established,to_server; http.uri; pcre:"/(?:%27|')\s*(?:or|and)\s+\d+\s*=\s*\d+/Ui"; classtype:web-application-attack; sid:1000001; rev:1;)
