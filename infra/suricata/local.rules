reject http any any -> any any (msg:"DEFENSA SQLi de alta confianza"; flow:established,to_server; http.uri; pcre:"/(?:%27|')\s*(?:or|and)\s+\d+\s*=\s*\d+/Ui"; classtype:web-application-attack; sid:1000001; rev:2;)
alert http any any -> any any (msg:"DEFENSA sondeo de archivo sensible"; flow:established,to_server; http.uri; pcre:"/\/(?:\.env|\.git(?:\/config)?|\.htaccess|\.htpasswd|wp-config\.php|database\.sql|id_rsa|backup|config\.php)/Ui"; classtype:web-application-attack; sid:1000002; rev:2;)
alert http any any -> any any (msg:"DEFENSA sondeo de copia de respaldo"; flow:established,to_server; http.uri; pcre:"/\.(?:bak|old|orig|save|swp)(?:\?|$)/Ui"; classtype:web-application-attack; sid:1000003; rev:1;)
alert http any any -> any any (msg:"DEFENSA escaneo web detectado (Nikto/ffuf)"; flow:established,to_server; http.user_agent; pcre:"/(?:nikto|ffuf|fuzz faster u fool|dirbuster|gobuster|wpscan|sqlmap|nmap|zaproxy)/i"; classtype:web-application-attack; sid:1000004; rev:3;)
